# Offline by default. Tests and the demo do not need an API key.
LLM_PROVIDER=stub

# Used only when LLM_PROVIDER=openai. Leave blank to stay on the stub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

MEMORY_DIR=.memory
LOG_LEVEL=INFO
MAX_STEPS=8
SHORT_TERM_WINDOW=12
